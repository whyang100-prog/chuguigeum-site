{
  "name": "chuguigeum-calculator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "npm run build && node --test calculator.test.mjs features.test.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "test:e2e": "npm run build && playwright test",
    "cleanup:legacy": "node scripts/cleanup-legacy.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
